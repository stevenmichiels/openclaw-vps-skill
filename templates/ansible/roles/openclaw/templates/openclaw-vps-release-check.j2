#!/usr/bin/env bash
set -euo pipefail
umask 077

ENV_FILE="{{ openclaw_env_file }}"
STATE_DIR="{{ openclaw_monitor_state_dir | default('/var/lib/openclaw-vps-monitor') }}"
BASE_IMAGE="{{ openclaw_container_base_image_effective }}"
REPO_API="https://api.github.com/repos/openclaw/openclaw/releases"

mkdir -p "$STATE_DIR"
chmod 0700 "$STATE_DIR"

current_tag="${BASE_IMAGE##*:}"
state_file="${STATE_DIR}/release-alerted-tag"

telegram_recipients() {
  local allow_file="/var/lib/openclaw/.openclaw/credentials/telegram-default-allowFrom.json"
  [ -f "$allow_file" ] || return 0
  jq -r '
    def walkids:
      if type == "string" or type == "number" then tostring
      elif type == "array" then .[] | walkids
      elif type == "object" then (keys[] | tostring), (.[] | walkids)
      else empty end;
    walkids
    | sub("^telegram:"; "")
    | select(test("^-?[0-9]+$"))
  ' "$allow_file" | sort -u
}

send_telegram() {
  local text="$1" token recipients
  token="$(grep -E '^TELEGRAM_BOT_TOKEN=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"
  [ -n "$token" ] || return 0
  recipients="$(telegram_recipients || true)"
  [ -n "$recipients" ] || return 0
  while IFS= read -r chat_id; do
    [ -n "$chat_id" ] || continue
    curl -fsS -X POST "https://api.telegram.org/bot${token}/sendMessage" \
      -d "chat_id=${chat_id}" \
      --data-urlencode "text=${text}" >/dev/null || true
  done <<< "$recipients"
}

latest_json="$(curl -fsSL "$REPO_API")"
latest_tag="$(printf '%s' "$latest_json" | jq -r '[.[] | select(.draft == false and .prerelease == false)][0].tag_name')"

if [ -z "$latest_tag" ] || [ "$latest_tag" = "null" ]; then
  echo "release_check=failed reason=no_stable_release"
  exit 1
fi

latest_image_tag="${latest_tag#v}"

if ! docker manifest inspect "ghcr.io/openclaw/openclaw:${latest_image_tag}" >/dev/null 2>&1; then
  echo "release_check=failed reason=missing_ghcr_tag latest=${latest_tag}"
  exit 1
fi

if [ "$latest_image_tag" = "$current_tag" ]; then
  rm -f "$state_file"
  echo "release_check=ok current=${current_tag} latest=${latest_image_tag}"
  exit 0
fi

echo "release_check=new_stable_available current=${current_tag} latest=${latest_image_tag}"

if [ ! -f "$state_file" ] || [ "$(cat "$state_file" 2>/dev/null || true)" != "$latest_image_tag" ]; then
  send_telegram "OpenClaw VPS: newer stable OpenClaw release available. Current ${current_tag}, latest ${latest_image_tag}. No auto-upgrade was performed."
  printf '%s\n' "$latest_image_tag" > "$state_file"
fi

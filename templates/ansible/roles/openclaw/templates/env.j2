# OpenClaw environment (managed by Ansible).
# Replace placeholder values before enabling openclaw service.

OPENCLAW_GATEWAY_TOKEN=__SET_ME__
OPENCLAW_GATEWAY_BIND={{ openclaw_gateway_bind | default('loopback') }}
OPENCLAW_GATEWAY_PORT={{ openclaw_gateway_port | default(18789) }}
OPENCLAW_BRIDGE_PORT={{ openclaw_bridge_port | default(18790) }}
OPENCLAW_CONFIG_DIR={{ openclaw_config_dir }}
OPENCLAW_WORKSPACE_DIR={{ openclaw_workspace_dir }}
OPENCLAW_SSH_DIR={{ openclaw_ssh_dir | default(openclaw_data_dir ~ '/.ssh') }}
OPENCLAW_TZ={{ openclaw_tz | default('UTC') }}

# Container image used by docker-compose runtime.
# The default is a local derivative with SSH, Python, and chart rendering tools.
OPENCLAW_IMAGE={{ openclaw_container_image | default('openclaw-runtime:2026.5.2-tools') }}

# Optional model provider credentials.
# For direct API-key `openai/*` models, set OPENAI_API_KEY.
# For ChatGPT subscription auth, sign in with OpenAI Codex OAuth:
#   openclaw models auth login --provider openai-codex
# On pinned 2026.5.2, the verified subscription route is `openai-codex/gpt-5.5`
# with auth profile mode and no OPENAI_API_KEY.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional channel credentials.
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Optional tool credentials.
BRAVE_API_KEY=
PERPLEXITY_API_KEY=
FIRECRAWL_API_KEY=

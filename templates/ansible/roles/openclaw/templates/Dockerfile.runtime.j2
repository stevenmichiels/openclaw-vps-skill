ARG OPENCLAW_BASE_IMAGE={{ openclaw_container_base_image_effective }}
FROM ${OPENCLAW_BASE_IMAGE}

USER root
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    fonts-dejavu-core \
    openssh-client \
    python3 \
    python3-matplotlib \
    python3-numpy \
  && rm -rf /var/lib/apt/lists/*
USER node
